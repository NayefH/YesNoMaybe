{
  "name": "yesnomaybe",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir dist --public-url ./",
    "export:gh-pages": "npm run export:web && node -e \"const fs=require('fs');fs.copyFileSync('dist/index.html','dist/404.html');fs.closeSync(fs.openSync('dist/.nojekyll','w'));\"",
    "build:web": "npx expo export --platform web",
    "deploy": "npm run build:web && gh-pages -d dist"
  },
  "dependencies": {
    "expo": "~54.0.13",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "gh-pages": "^6.3.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
