{
  "name": "yesnomaybe",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir dist",
    "export:fixpaths": "node -e \"const fs=require('fs');let html=fs.readFileSync('dist/index.html','utf8');html=html.replaceAll('href=\\\"/favicon.ico\\\"','href=\\\"./favicon.ico\\\"').replaceAll('src=\\\"/_expo/','src=\\\"./_expo/');fs.writeFileSync('dist/index.html',html);fs.writeFileSync('dist/404.html',html);fs.closeSync(fs.openSync('dist/.nojekyll','w'));\"",
    "export:gh-pages": "npm run export:web && npm run export:fixpaths",
    "deploy": "npm run export:gh-pages && gh-pages -d dist"
  },
  "dependencies": {
    "expo": "~54.0.13",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "gh-pages": "^6.3.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
